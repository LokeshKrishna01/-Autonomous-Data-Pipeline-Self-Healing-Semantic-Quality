# ── LLM ──────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-key-here
LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0.0

# ── Webhook Listener ──────────────────────────────────────────────────────────
WEBHOOK_SECRET=your-webhook-secret
API_HOST=0.0.0.0
API_PORT=8000

# ── GitHub ────────────────────────────────────────────────────────────────────
GITHUB_TOKEN=ghp_your-github-token
GITHUB_REPO=LokeshKrishna01/-Autonomous-Data-Pipeline-Self-Healing-Semantic-Quality
GITHUB_BASE_BRANCH=main

# ── Slack ─────────────────────────────────────────────────────────────────────
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_CHANNEL_ID=C0XXXXXXXXX

# ── Quarantine Storage ────────────────────────────────────────────────────────
QUARANTINE_BACKEND=duckdb
QUARANTINE_DUCKDB_PATH=./data/quarantine.duckdb

# ── Sandbox ───────────────────────────────────────────────────────────────────
SANDBOX_BACKEND=duckdb
SANDBOX_TIMEOUT_SECONDS=180

# ── Audit ─────────────────────────────────────────────────────────────────────
AUDIT_DB_URL=sqlite:///./data/audit.db

# ── dbt (optional) ────────────────────────────────────────────────────────────
DBT_PROJECT_PATH=
DBT_PROFILES_DIR=
